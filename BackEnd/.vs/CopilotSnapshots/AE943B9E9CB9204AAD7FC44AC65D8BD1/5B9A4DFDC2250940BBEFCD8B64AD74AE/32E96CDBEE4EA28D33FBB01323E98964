using Day1.Models;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace Day1.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class courseController : ControllerBase
    {
        private readonly ITIContext db;

        public courseController(ITIContext db)
        {
            this.db = db;
        }

        [HttpGet]
        public ActionResult get()
        {
            List<course> courses = db.Courses
                .Include(c => c.Department)
                .ToList();

            if (!courses.Any()) return NotFound();
            return Ok(courses);
        }

        [HttpDelete("{id:int}")]
        public ActionResult deleteCourse(int id)
        {
            course c = db.Courses.FirstOrDefault(n => n.id == id);
            if (c == null) return NotFound();

            db.Courses.Remove(c);
            db.SaveChanges();

            return Ok(db.Courses.ToList());
        }

        [HttpPut("{id:int}")]
        public ActionResult put(int id, course c)
        {
            if (c == null) return BadRequest();
            if (id != c.id) return BadRequest();

            course oldCourse = db.Courses.FirstOrDefault(n => n.id == id);
            if (oldCourse == null) return NotFound();

            if (c.DepartmentId.HasValue && !db.Departments.Any(d => d.ID == c.DepartmentId.Value))
                return BadRequest($"Department with id {c.DepartmentId.Value} was not found.");

            oldCourse.name = c.name;
            oldCourse.CourseDesc = c.CourseDesc;
            oldCourse.Duration = c.Duration;
            oldCourse.DepartmentId = c.DepartmentId;

            db.SaveChanges();
            return NoContent();
        }

        [HttpPost]
        public ActionResult post(course c)
        {
            if (c == null) return BadRequest();
            if (c.DepartmentId.HasValue && !db.Departments.Any(d => d.ID == c.DepartmentId.Value))
                return BadRequest($"Department with id {c.DepartmentId.Value} was not found.");

            c.id = (db.Courses.Max(n => (int?)n.id) ?? 0) + 1;

            db.Courses.Add(c);
            db.SaveChanges();

            return StatusCode(StatusCodes.Status201Created, c);
        }

        [HttpPatch("{id:int}/department/{departmentId:int}")]
        public ActionResult AssignDepartment(int id, int departmentId)
        {
            course? c = db.Courses.FirstOrDefault(n => n.id == id);
            if (c == null) return NotFound($"Course with id {id} was not found.");

            bool departmentExists = db.Departments.Any(d => d.ID == departmentId);
            if (!departmentExists) return NotFound($"Department with id {departmentId} was not found.");

            c.DepartmentId = departmentId;
            db.SaveChanges();

            return NoContent();
        }

        [HttpDelete("{id:int}/department")]
        public ActionResult RemoveDepartmentFromCourse(int id)
        {
            course? c = db.Courses.FirstOrDefault(n => n.id == id);
            if (c == null) return NotFound($"Course with id {id} was not found.");

            if (!c.DepartmentId.HasValue)
                return BadRequest("Course is not assigned to any department.");

            c.DepartmentId = null;
            db.SaveChanges();

            return NoContent();
        }

        [HttpGet("{id:int}")]
        public ActionResult getById(int id)
        {
            course c = db.Courses
                .Include(c => c.Department)
                .FirstOrDefault(n => n.id == id);

            if (c == null) return NotFound();

            return Ok(c);
        }

        [HttpGet("byname/{name}")]
        public ActionResult couseByName(string name)
        {
            course c = db.Courses
                .Include(c => c.Department)
                .FirstOrDefault(n => n.name == name);

            if (c == null) return NotFound();

            return Ok(c);
        }
    }
}